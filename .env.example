# Copy this file to .env and adjust the values.
# MongoDB connection string
# Atlas example: mongodb+srv://<user>:<password>@<cluster>/
MONGODB_URI=mongodb://localhost:27017
# Target database and collection
MONGODB_DATABASE=demo_cfdi
MONGODB_COLLECTION=cfdi
# Collection for certificates and digital seals (default: <MONGODB_COLLECTION>_signatures)
MONGODB_SIGNATURES_COLLECTION=cfdi_signatures
# Directory scanned for CFDI XML files when no argument is given
DATADIR=./xmls
